<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The foreground service that keeps the helper alive with no screen open, its type,
         the boot start, and the notification that shows it (runtime on API 33+; refused, the
         service still runs and shows only in the system's active-apps chip). Holder spec. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (API 30+): HomePackages asks PackageManager which packages answer
         HOME and SECONDARY_HOME, so `close` can refuse to remove a launcher. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.SECONDARY_HOME" />
        </intent>
        <!-- The app picker (M4) lists every launcher app by name. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ThorcutsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Thorcuts">

        <!-- Excluded from recents: on this ROM a swipe-away is launcher3's forceStopPackage
             (MEASURED 2026-10-14), which kills the helper and withholds the boot start until
             the next open. The launcher icon and the notification are the ways back. -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The keep-alive. specialUse: nothing else fits a gamepad grab; the property is the
             declaration API 34+ requires. Unenforced on this API 33 ROM; declared so the same
             APK survives a newer one. -->
        <service
            android:name=".HelperService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the controller-shortcut helper alive with no screen open" />
        </service>

        <!-- The foreground-app monitor: an accessibility service the user enables once in
             Settings; it reports which app holds input focus so the rule table can be per-app
             (M4). exported with the BIND_ACCESSIBILITY_SERVICE permission is the required
             shape: only the system holds that permission. -->
        <service
            android:name=".ForegroundAppMonitor"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/foreground_monitor" />
        </service>

        <!-- Not exported: BOOT_COMPLETED is a protected broadcast the system sends, and root
             and system uids pass the component check regardless. UNVERIFIED on this ROM until
             the holder's device run; the fallback is exported="true". -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
