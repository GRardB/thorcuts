# Release signing. Copy this file to keystore.properties at the repo root (gitignored) and fill
# it in. The release build is signed only while that file exists; without it `assembleRelease`
# yields an unsigned APK, and the debug build is unaffected either way.
#
# Create the keystore once, OUTSIDE the repo, and back the file up somewhere that is not this
# machine: every later release must carry the same key, or installed copies cannot update.
#
#   keytool -genkeypair -v -keystore ~/thorcuts-release.jks -alias thorcuts \
#       -keyalg RSA -keysize 4096 -validity 36500
#
# storeFile is an absolute path (no ~).
storeFile=/Users/you/thorcuts-release.jks
storePassword=
keyAlias=thorcuts
keyPassword=
